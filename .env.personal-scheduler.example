# Personal scheduler add-on env vars (in addition to the existing lettabot vars).
# Copy what you need into Railway -> Variables (or local .env).

# --- Telegram bot (already required by lettabot) ---
# Set this in lettabot.yaml under channels.telegram.token, OR via env if you prefer.
# TELEGRAM_BOT_TOKEN=...

# --- LLM provider (already required by Letta) ---
# Either:
#   - lettabot connect chatgpt   (uses your ChatGPT subscription credits)
#   - or your GPT proxy:
#     OPENAI_API_BASE=https://your-proxy.example.com/v1
#     OPENAI_API_KEY=...

# --- Google Calendar tool (this branch adds it) ---
# Run scripts/google-oauth.mjs once locally to obtain the refresh token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Optional overrides
# GOOGLE_CALENDAR_ID=primary
# GOOGLE_CALENDAR_TIMEZONE=Asia/Seoul

# --- Letta server (selfhost mode) ---
# If you run the Letta server in a sibling Railway service or via docker compose,
# set the Letta API base URL here. lettabot.yaml -> server.mode: docker, baseUrl: <below>
# LETTA_BASE_URL=http://letta-server:8283
